probe() { # host path [extra curl args...]
  local host="$1" path="$2"; shift 2
  local hts=$(date -u +%H:%M:%S)
  local out="$(echo "${host}${path}" | tr '/?=&.' '____')"
  curl -sS -m 12 -o "${out}.body" -D "${out}.hdr" -w "%{http_code}|%{size_download}" "$@" "https://${host}${path}" 2>"${out}.err"
  local code="$?"
  local stat="$(cat "${out}.body" 2>/dev/null | head -c 120 | tr '\n' ' ')"
  echo "${hts}Z ${host}${path} -> curl=${code} status=$(cat "${out}.body" | wc -c)"
  sleep 1
}
